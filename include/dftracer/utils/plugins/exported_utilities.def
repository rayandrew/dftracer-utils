/* Every host utility exposed to plugins, one per line, in ABI id order.
 * APPEND ONLY - the enum id is each entry's ordinal; never renumber, reorder,
 * or reuse a retired id.
 *
 *   DFTU_EXPORT_UTILITY(TAG, name, INVOCABLE, IN, OUT)
 *     TAG   - UPPER_SNAKE id suffix (DFTU_UTIL_<TAG>).
 *     name  - lower_snake wrapper/tag suffix (dftu_util_<name>, util::<name>).
 *     INVOCABLE - a Utility<IN,OUT> subclass (driven via process()) or a
 *                 stateless functor (called as operator()(in)).
 *     IN/OUT - native C++ input/output types. OUT = AsyncGenerator<E> or
 *              vector<E> declares a stream of E (the _stream wrapper); OUT =
 *              optional<E> is a single value that may be absent; anything else
 *              is a single value. A scalar IN/OUT crosses as its direct C type,
 *              a struct as a generated dftu_ struct.
 */

#ifndef DFTU_EXPORT_UTILITY
#define DFTU_EXPORT_UTILITY(TAG, name, INVOCABLE, IN, OUT)
#endif

DFTU_EXPORT_UTILITY(FNV1A, fnv1a, ::dftracer::utils::plugins::scalar::Fnv1a,
                   std::string_view, std::uint64_t)

DFTU_EXPORT_UTILITY(HEX64_PARSE, hex64_parse,
                   ::dftracer::utils::plugins::scalar::Hex64Parse,
                   std::string_view, std::optional<std::uint64_t>)

DFTU_EXPORT_UTILITY(HEX64_FORMAT, hex64_format,
                   ::dftracer::utils::plugins::scalar::Hex64Format,
                   std::uint64_t, dftu_hex16)

DFTU_EXPORT_UTILITY(
    LINE_FILTER, line_filter,
    ::dftracer::utils::utilities::text::LineFilterUtility,
    ::dftracer::utils::utilities::text::FilterableLine,
    ::dftracer::utils::coro::AsyncGenerator<
        ::dftracer::utils::utilities::fileio::lines::Line>)

DFTU_EXPORT_UTILITY(
    VIEW_SCANNER, view_scanner,
    ::dftracer::utils::trace::views::ViewScannerUtility,
    ::dftracer::utils::trace::views::ViewScannerInput,
    ::dftracer::utils::coro::AsyncGenerator<
        ::dftracer::utils::trace::views::ViewScannerBatch>)

DFTU_EXPORT_UTILITY(
    METADATA_COLLECTOR, metadata_collector,
    ::dftracer::utils::trace::MetadataCollectorUtility,
    ::dftracer::utils::trace::MetadataCollectorUtilityInput,
    ::dftracer::utils::trace::
        MetadataCollectorUtilityOutput)

DFTU_EXPORT_UTILITY(
    EVENT_COLLECTOR, event_collector,
    ::dftracer::utils::trace::
        EventCollectorFromMetadataUtility,
    ::dftracer::utils::trace::
        EventCollectorFromMetadataCollectorUtilityInput,
    ::dftracer::utils::coro::AsyncGenerator<
        ::dftracer::utils::trace::EventId>)

DFTU_EXPORT_UTILITY(
    DIRECTORY_SCANNER, directory_scanner,
    ::dftracer::utils::utilities::filesystem::DirectoryScannerUtility,
    ::dftracer::utils::utilities::filesystem::DirectoryScannerUtilityInput,
    std::vector<::dftracer::utils::utilities::filesystem::FileEntry>)

DFTU_EXPORT_UTILITY(
    PATTERN_DIRECTORY_SCANNER, pattern_directory_scanner,
    ::dftracer::utils::utilities::filesystem::PatternDirectoryScannerUtility,
    ::dftracer::utils::utilities::filesystem::PatternDirectoryScannerUtilityInput,
    std::vector<::dftracer::utils::utilities::filesystem::FileEntry>)

DFTU_EXPORT_UTILITY(
    FILE_READER, file_reader,
    ::dftracer::utils::utilities::fileio::FileReaderUtility,
    ::dftracer::utils::utilities::filesystem::FileEntry,
    ::dftracer::utils::utilities::text::Text)

DFTU_EXPORT_UTILITY(
    FILE_COMPRESSOR, file_compressor,
    ::dftracer::utils::utilities::fileio::FileCompressorUtility,
    ::dftracer::utils::utilities::fileio::FileCompressionUtilityInput,
    ::dftracer::utils::utilities::fileio::FileCompressionUtilityOutput)

DFTU_EXPORT_UTILITY(
    FILE_DECOMPRESSOR, file_decompressor,
    ::dftracer::utils::utilities::fileio::FileDecompressorUtility,
    ::dftracer::utils::utilities::fileio::FileDecompressionUtilityInput,
    ::dftracer::utils::utilities::fileio::FileDecompressionUtilityOutput)

#undef DFTU_EXPORT_UTILITY
