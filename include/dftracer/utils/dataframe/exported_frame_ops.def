/* Built-in dataframe frame ops (table -> table) seeded into the op registry
 * under the "frame." prefix (so they neither clash with the same-named column
 * ops nor need a separate registry). APPEND ONLY.
 *
 *   DFTU_FRAME_OP(name, fn, ret, o0, o1, o2, o3, o4)
 *     name        - registry key suffix; registered as "frame.<name>".
 *     fn          - the dftu_dataframe_* (or dftu_series_*) C ABI function.
 *     ret,o0..o4  - signature tokens (DFTU_TOK_* suffixes), packed by
 *                   DFTU_OP_SIG6. A frame op reads its dftu_dataframe operands
 *                   from frames[]; every other operand rides dftu_op_arg
 *                   (SERIES -> series0/series1, STR -> s0..s3, STRLIST ->
 *                   slist/slist2, I64 -> i0/i1, I32/enum -> op_code, SCALAR ->
 *                   scalar).
 *
 * Deferred (bespoke C shapes, not a value-operand fit): group_by (out-params),
 * group_by_dynamic (dftu_group_agg[] array), mask (a compiled dftu_query),
 * take (int64 index array), sample (uint64 seed), is_duplicated/is_unique
 * (frame -> series). Use their dftu_dataframe_* ABI / DataFrame methods.
 */

#ifndef DFTU_FRAME_OP
#define DFTU_FRAME_OP(name, fn, ret, o0, o1, o2, o3, o4)
#endif

/* table -> table, no extra operand. */
DFTU_FRAME_OP(drop_nulls, dftu_dataframe_drop_nulls, FRAME, FRAME, NONE, NONE, NONE, NONE)
DFTU_FRAME_OP(unique, dftu_dataframe_unique, FRAME, FRAME, NONE, NONE, NONE, NONE)
DFTU_FRAME_OP(drop_duplicates, dftu_dataframe_drop_duplicates, FRAME, FRAME, NONE, NONE, NONE, NONE)
DFTU_FRAME_OP(reverse, dftu_dataframe_reverse, FRAME, FRAME, NONE, NONE, NONE, NONE)
DFTU_FRAME_OP(describe, dftu_dataframe_describe, FRAME, FRAME, NONE, NONE, NONE, NONE)
DFTU_FRAME_OP(null_count, dftu_dataframe_null_count, FRAME, FRAME, NONE, NONE, NONE, NONE)

/* table + int64(s). */
DFTU_FRAME_OP(head, dftu_dataframe_head, FRAME, FRAME, I64, NONE, NONE, NONE)
DFTU_FRAME_OP(tail, dftu_dataframe_tail, FRAME, FRAME, I64, NONE, NONE, NONE)
DFTU_FRAME_OP(slice, dftu_dataframe_slice, FRAME, FRAME, I64, I64, NONE, NONE)

/* table + scalar / mask. */
DFTU_FRAME_OP(fill_null, dftu_dataframe_fill_null, FRAME, FRAME, SCALAR, NONE, NONE, NONE)
DFTU_FRAME_OP(filter, dftu_dataframe_filter, FRAME, FRAME, SERIES, NONE, NONE, NONE)

/* table + column name(s). */
DFTU_FRAME_OP(with_row_index, dftu_dataframe_with_row_index, FRAME, FRAME, STR, NONE, NONE, NONE)
DFTU_FRAME_OP(explode, dftu_dataframe_explode, FRAME, FRAME, STR, NONE, NONE, NONE)
DFTU_FRAME_OP(to_dummies, dftu_dataframe_to_dummies, FRAME, FRAME, STR, NONE, NONE, NONE)
DFTU_FRAME_OP(sort_by, dftu_dataframe_sort_by, FRAME, FRAME, STR, I32, NONE, NONE)
DFTU_FRAME_OP(select, dftu_dataframe_select, FRAME, FRAME, STRLIST, NONE, NONE, NONE)
DFTU_FRAME_OP(rename, dftu_dataframe_rename, FRAME, FRAME, STRLIST, NONE, NONE, NONE)
DFTU_FRAME_OP(sort_by_multi, dftu_dataframe_sort_by_multi, FRAME, FRAME, STRLIST, I32, NONE, NONE)
DFTU_FRAME_OP(with_column, dftu_dataframe_with_column, FRAME, FRAME, STR, SERIES, NONE, NONE)
DFTU_FRAME_OP(unpivot, dftu_dataframe_unpivot, FRAME, FRAME, STRLIST, STRLIST, NONE, NONE)
DFTU_FRAME_OP(topk, dftu_dataframe_topk, FRAME, FRAME, STR, I64, I32, NONE)
DFTU_FRAME_OP(pivot, dftu_dataframe_pivot, FRAME, FRAME, STR, STR, STR, STR)

/* series -> table. */
DFTU_FRAME_OP(value_counts, dftu_series_value_counts, FRAME, SERIES, NONE, NONE, NONE, NONE)

#undef DFTU_FRAME_OP
